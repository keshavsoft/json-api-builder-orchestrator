{
  "name": "json-api-builder-orchestrator",
  "version": "1.2.2",
  "description": "Orchestrator for the modular JSON API Builder stages.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./v1": "./src/v1/index.js",
    "./v2": "./src/v2/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs"
